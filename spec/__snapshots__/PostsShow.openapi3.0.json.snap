{
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "title": {
      "type": "string",
      "nullable": true
    },
    "body": {
      "type": "string",
      "nullable": true
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "category": {
      "type": "string",
      "enum": [
        "news",
        "article",
        "blog"
      ]
    },
    "author": {
      "$ref": "#/components/schemas/User"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "body",
    "published_at",
    "category",
    "author",
    "summary"
  ]
}